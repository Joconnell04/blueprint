    "nodeMaxH": 130,
    "maxNodeLines": 2,
    "edgePt": 1.25,
    "edgeColor": "muted"
  },
  "kicker": {
    "pattern": "{section} | {topic}"
  },
  "divider": {
    "numbered": true
  },
  "stat": {
    "rule": "below"
  },
  "typeScale": {

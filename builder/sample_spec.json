            ],
            [
              "Average discount",
              "Fieldnote CRM",
              2025,
              "Closed won deals, trailing four quarters",
              "Internal"
            ]
          ]
        },
        {
          "id": "b_method",
          "type": "text",
          "title": "Method notes",
          "row": 10,
          "col": 2,
          "cols": 6,
          "text": "Accounts are counted at the firm level, not the establishment level, so multi site firms appear once. Public sector accounts sit outside the SBA universe and were added from the state and local procurement file. Nothing here is recalculated in Excel by the builder, so open the file once and let Excel compute."
        },
        {
          "id": "b_open",
          "type": "inputs",
          "title": "Open items",
          "row": 13,
          "col": 2,

{
  "name": "blueprint",
  "version": "0.3.3",
  "type": "module",
  "private": true,
  "description": "MCP App for Claude Desktop: plan workbooks and decks on a canvas, then Claude builds the .xlsx or .pptx",
  "scripts": {
    "build": "tsc -p tsconfig.server.json && cross-env INPUT=mcp-app.html vite build",
    "build:ui": "cross-env INPUT=mcp-app.html vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/server/main.js",
    "dev:ui": "cross-env NODE_ENV=development INPUT=mcp-app.html vite build --watch",
    "test:builder": "python3 builder/test_build.py",
    "test:deck-builder": "python3 builder/test_build_pptx.py",
    "test:diagram": "python3 builder/test_diagram_layout.py",
    "test:flow": "tsx test/flow.test.ts",
    "test:deck-flow": "tsx test/deck-flow.test.ts",
    "test:e2e": "playwright test -c test/e2e/playwright.config.ts",
    "test:layout": "tsx test/layout.test.ts",
    "test:import": "tsx test/import.test.ts",
    "test:import-deck": "python3 builder/test_import_pptx.py && tsx test/import-deck.test.ts",
    "test:scan": "python3 builder/test_import_scan.py",
    "test": "npm run test:builder && npm run test:deck-builder && npm run test:diagram && npm run test:scan && npm run test:check && npm run test:check-workbook && npm run test:restyle && npm run test:layout && npm run test:flow && npm run test:deck-flow && npm run test:import && npm run test:import-deck && npm run test:formulas && npm run test:extract-py && npm run test:extract && npm run test:e2e",
    "test:extract-py": "python3 builder/test_extract_format.py",
    "test:check": "python3 builder/test_check_formulas.py",
    "test:check-workbook": "python3 builder/test_check_workbook.py",
    "bundle": "./scripts/bundle.sh",
    "test:restyle": "python3 builder/test_restyle.py",
    "test:formulas": "tsx test/import-formulas.test.ts",
    "test:extract": "tsx test/extract.test.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.0",
    "cross-env": "^10.1.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/core": "^2.0.0",
    "@modelcontextprotocol/express": "^2.0.0",
    "@modelcontextprotocol/ext-apps": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  }
}
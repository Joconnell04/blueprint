{
  "name": "House",
  "note": "Neutral consulting default: kicker, action headline, rounded 1 pt cards, muted body, source line, page number. Geometry follows docs/research/deck-planning.md section 6.",
  "palette": {
    "bg": "FFFFFF",
    "ink": "1F2937",
    "muted": "6B7280",
    "accent": "3B5BDB",
    "accent2": "1F2937",

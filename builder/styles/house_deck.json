    "ruleColor": "D1D5DB",
    "rowHeightPt": 22,
    "labelColumn": {
      "case": "none",
      "color": "ink",
      "bold": true
    }
  },
  "chart": {
    "legend": "bottom",
    "gridlines": true
  },
